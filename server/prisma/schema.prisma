generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 AGENT
}
enum ConversationStatus {
 OPEN
 CLOSED
}
enum TicketStatus {
 OPEN
 IN_PROGRESS
 RESOLVED
}
enum Priority {
 LOW
 MEDIUM
 HIGH
}
enum Direction {
 INBOUND
 OUTBOUND
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role Role @default(AGENT)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Contact {
 id String @id @default(cuid())
 name String
 phoneNumber String @unique
 createdAt DateTime @default(now())
 conversations Conversation[]
 tickets Ticket[]
}
model Conversation {
 id String @id @default(cuid())
 contactId String
 contact Contact @relation(fields: [contactId], references: [id])
 status ConversationStatus @default(OPEN)
 channel String @default("WHATSAPP")
 webSession WebSession?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 messages Message[]
 tickets Ticket[]
 @@index([contactId, status])
 @@index([channel, updatedAt])
}

model WebSession {
 id String @id @default(cuid())
 tokenHash String @unique
 conversationId String @unique
 conversation Conversation @relation(fields: [conversationId], references: [id])
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
}

model PublicRateBucket {
 key String @id
 hits Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}
model Message {
 id String @id @default(cuid())
 conversationId String
 conversation Conversation @relation(fields: [conversationId], references: [id])
 externalMessageId String? @unique
 source String @default("HUMAN")
 deliveryStatus String @default("UNKNOWN")
 deliveryError String?
 statusAt DateTime?
 mediaId String?
 mimeType String?
 replyToId String? @unique
 job ReplyJob?
 direction Direction
 content String
 messageType String
 createdAt DateTime @default(now())
 @@index([conversationId, createdAt])
}
model Ticket {
 id String @id @default(cuid())
 contactId String
 contact Contact @relation(fields: [contactId], references: [id])
 conversationId String?
 conversation Conversation? @relation(fields: [conversationId], references: [id])
 title String
 description String
 status TicketStatus @default(OPEN)
 priority Priority @default(MEDIUM)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, createdAt])
 @@index([contactId])
 @@index([conversationId])
}

model ReplyJob {
 id String @id @default(cuid())
 messageId String @unique
 message Message @relation(fields: [messageId], references: [id])
 conversationId String
 sequence BigInt @unique @default(autoincrement())
 state String @default("PENDING")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 leaseUntil DateTime?
 errorCode String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([state, availableAt])
 @@index([conversationId, sequence])
}

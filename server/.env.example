DATABASE_URL=postgresql://sentia:change-local-password@127.0.0.1:5432/sentia?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
CORS_ORIGIN=http://localhost:5173
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Select a supported Graph API version in your Meta developer app.
WHATSAPP_GRAPH_VERSION=v26.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=false
AI_AUTO_REPLY=false
AI_TIMEOUT_MS=30000
META_TIMEOUT_MS=15000
AI_CONTEXT_MESSAGES=20
AI_CONTEXT_CHARS=16000
WORKER_POLL_MS=2000
# Public web chat (independent from WhatsApp auto reply)
WEB_CHAT_AI_ENABLED=true
WEB_CHAT_SESSION_HOURS=24
WEB_CHAT_MAX_MESSAGES=50
WEB_CHAT_MAX_CONCURRENT=3
WEB_CHAT_DAILY_LIMIT=500
ADMIN_NAME=
ADMIN_EMAIL=
